{
  "name": "childhood-ai-chat",
  "version": "0.2.0",
  "description": "아이들을 위한 안전한 AI 채팅 서비스 (React + Express)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server.js",
    "build": "vite build",
    "start": "node server.js",
    "test": "NODE_ENV=test node --test tests/*.test.js",
    "test:ui": "node --test tests/ui/*.test.js",
    "test:all": "npm test && npm run test:ui"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.63.0"
  }
}
